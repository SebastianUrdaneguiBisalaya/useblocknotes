{
  "name": "useblocknotes",
  "type": "module",
  "private": true,
  "description": "Open-source Notion-style block editor built on Tiptap, with AI responses streamed live into the editor.",
  "keywords": [
    "notion",
    "block-editor",
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "ai",
    "streaming",
    "typescript",
    "react",
    "pdf",
    "monorepo"
  ],
  "license": "MIT",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/useblocknotes.git"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/useblocknotes#readme",
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/useblocknotes/issues"
  },
  "module": "index.ts",
  "workspaces": {
    "packages": [
      "packages/*",
      "storybook"
    ],
    "catalog": {
      "@happy-dom/global-registrator": "21.0.4",
      "@testing-library/dom": "10.4.2",
      "@testing-library/react": "16.3.3",
      "@types/bun": "1.4.4",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "tsup": "8.5.1",
      "typescript": "6.0.3",
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.11",
    "@changesets/cli": "3.0.3",
    "husky": "9.1.7",
    "publint": "0.3.25"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "check:package": "bun scripts/check-package.ts",
    "dev": "bun run --filter './packages/*' dev",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun run --filter './packages/*' test",
    "test:watch": "bun test --watch",
    "storybook": "bun run --filter @useblocknotes/storybook dev",
    "build-storybook": "bun run --filter @useblocknotes/storybook build",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install"
  }
}
