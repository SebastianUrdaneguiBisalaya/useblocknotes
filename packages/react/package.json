{
  "name": "@useblocknotes/react",
  "version": "0.1.0",
  "description": "React 19 components and hooks for useblocknotes: a Notion-style block editor on Tiptap with live AI streaming.",
  "keywords": [
    "notion",
    "block-editor",
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "ai",
    "streaming",
    "typescript",
    "react",
    "react-component",
    "hooks",
    "slash-menu"
  ],
  "license": "MIT",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/useblocknotes.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/useblocknotes/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/useblocknotes/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "peerDependencies": {
    "@useblocknotes/core": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@useblocknotes/core": "workspace:^",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
