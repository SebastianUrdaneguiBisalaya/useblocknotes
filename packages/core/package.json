{
  "name": "@useblocknotes/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core of useblocknotes: document model, block registry, operations, AI stream protocol and context functions.",
  "keywords": [
    "notion",
    "block-editor",
    "editor",
    "rich-text",
    "tiptap",
    "prosemirror",
    "ai",
    "streaming",
    "typescript",
    "blocks",
    "document-model",
    "operations",
    "zod",
    "framework-agnostic"
  ],
  "license": "MIT",
  "author": {
    "name": "Sebastian Marat Urdanegui Bisalaya",
    "url": "https://sebastianurdanegui.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastianUrdaneguiBisalaya/useblocknotes.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/SebastianUrdaneguiBisalaya/useblocknotes/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/SebastianUrdaneguiBisalaya/useblocknotes/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:watch": "bun test --watch",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@types/bun": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "zod": "^4"
  }
}
