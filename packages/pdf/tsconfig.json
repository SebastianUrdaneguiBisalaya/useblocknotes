{
  // PDF export: the shared base. Type-checks against core's source so `typecheck` doesn't need core built first.
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "paths": {
      "@useblocknotes/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "tests"
  ]
}
